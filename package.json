{
  "name": "paper-companion",
  "version": "0.1.1",
  "description": "Search your Zotero library by meaning, create literature notes, and get page-cited reading notes and answers from a local model.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && eslint . && node esbuild.config.mjs production",
    "test": "vitest run",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint .",
    "quotes:pdf-live": "esbuild scripts/pdf-quotes-live.ts --bundle --platform=node --format=cjs --external:pdfjs-dist --outfile=.e2e/pdf-quotes-live.cjs && node .e2e/pdf-quotes-live.cjs"
  },
  "keywords": [
    "obsidian",
    "zotero",
    "papers",
    "research",
    "ollama",
    "local"
  ],
  "author": "Tony Peonio",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.5.0",
    "obsidian": "^1.14.4",
    "pdfjs-dist": "^6.5.438",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
